# EMS — ADMIN PORTAL ONLY
# Copy to .env and fill in values. Never commit .env.

# Supabase (use Secret/Service key on server for review + scheduling RPCs)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Gmail SMTP — approval/rejection emails to students
GMAIL_USER=your-school-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ADMIN_EMAIL=your-school-email@gmail.com
SCHOOL_NAME=Enrollment Management System

# Cloud AI for auto-scheduling — free cloud APIs only (no local LLM)
# Primary: Groq — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Fallback: Google Gemini free tier — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Fallback 2: OpenRouter (paid models only — set AI_ENABLE_OPENROUTER=1 to use)
# AI_ENABLE_OPENROUTER=0
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: port override (default 8001)
# PORT=8001
